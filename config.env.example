# Identifiers and paths only. Do not put passwords, tokens, or signed URLs here.
OPENRC=/path/to/openrc
NODE_NAME=node-001
IMAGE_NAME=ubuntu-2404-gpu-image
USER_DATA_FILE=cloud-init/gpu-runtime-multipart.txt
FLAVOR=baremetal-h200
ETH_PORT_ID=replace-with-ethernet-port-uuid
ETH_MAC=52:54:00:12:34:56
# Optional only for an intentionally Ethernet-only node. Mixed-fabric H200
# runs require both values and Ironic network_interface=ipoib.
IPOIB_PORT_ID=
IPOIB_MAC=
KEYPAIR=gpu-workload-key
SERVER_NAME_PREFIX=h200-image-lora
EXISTING_SERVER_UUID=
GUEST_USER=ubuntu
GUEST_SSH_KEY=~/.ssh/id_rsa
GUEST_PROXY_JUMP=
# Optional temporary reverse SOCKS tunnel through the workflow host.
GUEST_EGRESS_PROXY=
WORKLOAD_DIGEST=registry.example.com/ai/h200-image-lora@sha256:replace
# Optional offline transport for a read-only/unavailable registry.
WORKLOAD_ARCHIVE=
BASE_MODEL_DIR=/srv/ai-inputs/sdxl-base-1.0
DATASET_DIR=/srv/ai-inputs/cute-bear-v1
REMOTE_INPUT_ROOT=/var/lib/h200-image-model
RUNS_ROOT=/var/log/ai-runs/h200-image-lora
TRAIN_STEPS=300
PILOT_STEPS=40
LORA_RANK=32
RESOLUTION=1024
TRAIN_SEED=26081001
PROMPTS_FILE=prompts/bear-v1.json
MAX_DATASET_IMAGES=48
OPENSTACK_TIMEOUT=120
DEPLOY_TIMEOUT=5400
SSH_TIMEOUT=900
TRAIN_TIMEOUT=7200
